# Claves de Configuración de Firebase para Despertar Sanaciones
# Reemplaza estos valores con los provistos en tu consola de Firebase:
# Consola de Firebase -> Configuración del proyecto -> Aplicaciones Web (SDK Setup)

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=despertar-sanaciones.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=despertar-sanaciones
VITE_FIREBASE_STORAGE_BUCKET=despertar-sanaciones.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
